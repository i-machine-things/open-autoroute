build/
cmake-build-*/
*.o
*.a
*.so
compile_commands.json

# flatpak-builder's own build output, and the packaged plugin tarball it produces (see
# flatpak/Makefile). Both the top-level `flatpak` target (Makefile, CMakeLists.txt) and a direct
# `make -C flatpak` run flatpak-builder with flatpak/ as its cwd, so the cache always lands there.
flatpak/app/
flatpak/.flatpak-builder/
flatpak/*.tar.gz
flatpak/*.generated.yaml

# Isolated worktrees created by review agents
.claude/worktrees/
